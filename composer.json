{
    "name": "mendelkahan/laravel-puresms",
    "description": "Laravel package for PureSMS integration.",
    "version": "1.1.4",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Puresms\\Laravel\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Mendel Kahan",
            "email": "mendy@famkahan.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Puresms\\Laravel\\PureSmsServiceProvider"
            ],
            "aliases": {
                "PureSms": "Puresms\\Laravel\\Facades\\PureSms"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
